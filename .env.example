NODE_ENV=production
HOST=127.0.0.1
PORT=3001

# MongoDB is only reachable locally on the VPS. Use a dedicated readWrite user
# created inside the cupi_store database; never use the MongoDB admin account here.
MONGODB_URI=mongodb://cupiStoreApp:CHANGE_ME@127.0.0.1:27017/cupi_store?authSource=cupi_store
MONGODB_DB=cupi_store

# Generate the hash with: npm run admin:hash
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=PASTE_BCRYPT_HASH_HERE
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=true

# Keep this directory outside .output so builds never erase uploaded images.
UPLOAD_DIR=/home/deploy/apps/cupi-store/uploads
PUBLIC_UPLOAD_BASE=/uploads
MAX_IMAGE_BYTES=3145728
